# Copy to .env. Never commit .env.
# Local defaults match docker-compose.yml. They are for a laptop only.

# App database. Inside the Airflow container this host is "postgres", not localhost.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# duckdb (default, free) or snowflake.
WAREHOUSE_TARGET=duckdb

# Leave unset to use <repo>/warehouse/analytics.duckdb.
# If you set it, use an absolute path. dbt resolves relative paths from transform/.
# DUCKDB_PATH=

# Optional. make seed uses 42 when SEED is unset.
# SEED=42

# Snowflake is optional. Required only for the snowflake dbt target,
# the snowflake ingest target, and terraform apply.
# dbt account format is the account identifier, often orgname-accountname
# or locator.region.cloud (for example xy12345.us-east-1).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_LOADER_ROLE=LOADER
SNOWFLAKE_TRANSFORM_ROLE=TRANSFORMER

# Terraform provider reads these names (they are not TF_VAR_* aliases).
# On a trial, SNOWFLAKE_ROLE is usually ACCOUNTADMIN.
# Organization and account are the two halves of the account identifier,
# not the dbt account locator string above.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=

# Optional. Grant the three warehouse roles to an existing Snowflake user.
# TF_VAR_grant_to_user=

# Local Airflow UI only. Change these if port 8080 is reachable beyond your machine.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=saurav@example.com
