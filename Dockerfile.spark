# apache/spark:3.5.5 keeps Spark 3.5.x and the Kafka connector package.
# Its python3 is Ubuntu's (3.8 on focal). duckdb 1.5.5 publishes no wheel
# for that interpreter. Deadsnakes no longer publishes Python 3.12 for focal,
# and apt then treats the package name as a regex and installs PostgreSQL
# instead. Python 3.12 is a pinned python-build-standalone build at /opt/py.
FROM apache/spark:3.5.5

USER root

COPY requirements-runtime.txt /tmp/requirements-runtime.txt

# cpython 3.12.14, release 20260924, x86_64 glibc install_only.
# https://github.com/astral-sh/python-build-standalone/releases/tag/20260924
ARG PYTHON_STANDALONE_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260924/cpython-3.12.14%2B20260924-x86_64-unknown-linux-gnu-install_only.tar.gz
ARG PYTHON_STANDALONE_SHA256=5eae8cf79dd47fc2496a4fccc892936be831ce7a84d984b2299dfb1cdb592682

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    curl -fsSL -o /tmp/python.tgz "${PYTHON_STANDALONE_URL}"; \
    echo "${PYTHON_STANDALONE_SHA256}  /tmp/python.tgz" | sha256sum -c -; \
    mkdir -p /opt/py; \
    tar -xzf /tmp/python.tgz -C /opt/py --strip-components=1; \
    rm -f /tmp/python.tgz; \
    rm -rf /var/lib/apt/lists/*; \
    /opt/py/bin/python -c 'import sys; assert sys.version_info[:2]==(3,12)'; \
    /opt/py/bin/python -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt; \
    py4j=$(find /opt/spark/python/lib -name 'py4j-*-src.zip' -print -quit); \
    test -n "$py4j"; \
    test -f "$py4j"; \
    site=$(/opt/py/bin/python -c 'import site; print(site.getsitepackages()[0])'); \
    printf '%s\n%s\n' /opt/spark/python "$py4j" > "${site}/spark.pth"; \
    chmod -R a+rX /opt/py /opt/spark/python; \
    /opt/py/bin/python -c 'import pyspark, duckdb; assert pyspark.__version__.startswith("3.5.")'

# Compose runs this image as ${AIRFLOW_UID}:0. Java reads user.home from
# passwd, not from HOME. With no entry that path is "?", and Ivy then crashes
# on ?/.ivy2. Group 0 must own the write bit; chmod g=u alone does not change
# the file's group. scripts/spark_entrypoint.sh records the uid with home /tmp
# before the Spark entrypoint runs. Kafka jars are resolved once here so
# spark-submit does not download them.
COPY scripts/spark_entrypoint.sh /opt/spark-entrypoint.sh
RUN <<'EOF'
set -eux
chmod 755 /opt/spark-entrypoint.sh
chgrp 0 /etc/passwd
chmod g=u /etc/passwd
mkdir -p /opt/spark/work-dir /opt/spark/ivy /opt/spark/conf
chgrp -R 0 /opt/spark/work-dir
chmod -R g+rwX /opt/spark/work-dir
touch /opt/spark/conf/spark-defaults.conf
grep -q '^spark.jars.ivy ' /opt/spark/conf/spark-defaults.conf || printf '%s\n' 'spark.jars.ivy /opt/spark/ivy' >> /opt/spark/conf/spark-defaults.conf
cat > /tmp/resolve_kafka.py << 'PY'
from pyspark.sql import SparkSession
spark = SparkSession.builder.master("local[1]").config("spark.ui.enabled", "false").getOrCreate()
print(spark.version)
spark.stop()
PY
HOME=/tmp /opt/spark/bin/spark-submit \
  --master local[1] \
  --driver-memory 512m \
  --conf spark.ui.enabled=false \
  --conf spark.jars.ivy=/opt/spark/ivy \
  --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.5 \
  /tmp/resolve_kafka.py
find /opt/spark/ivy -name 'spark-sql-kafka*.jar' | grep -q .
chgrp -R 0 /opt/spark/ivy
chmod -R g+rwX /opt/spark/ivy
rm -f /tmp/resolve_kafka.py
/opt/py/bin/python - << 'PY'
import os, pathlib, pwd, sys
pid = os.fork()
if pid == 0:
    os.setgid(0)
    os.setuid(1001)
    if not os.access("/etc/passwd", os.W_OK):
        os._exit(2)
    with open("/etc/passwd", "a", encoding="utf-8") as fh:
        fh.write("1001:x:1001:0:spark:/tmp:/bin/false\n")
    os._exit(0)
_, status = os.waitpid(pid, 0)
if os.waitstatus_to_exitcode(status) != 0:
    sys.exit("uid 1001 gid 0 could not write /etc/passwd")
if pwd.getpwuid(1001).pw_dir != "/tmp":
    sys.exit("passwd home was not /tmp")
path = pathlib.Path("/etc/passwd")
path.write_text(
    "".join(
        line
        for line in path.read_text(encoding="utf-8").splitlines(keepends=True)
        if not line.startswith("1001:")
    ),
    encoding="utf-8",
)
PY
EOF

WORKDIR /opt/project
ENTRYPOINT ["/opt/spark-entrypoint.sh"]
ENV PYTHONPATH=/opt/project \
    HOME=/tmp \
    SPARK_SUBMIT_OPTS="-Duser.home=/tmp" \
    PATH="/opt/py/bin:${PATH}" \
    PYSPARK_PYTHON=/opt/py/bin/python \
    PYSPARK_DRIVER_PYTHON=/opt/py/bin/python
