# apache/spark:3.5.5 keeps Spark 3.5.x and the Kafka connector package.
# Its python3 is Ubuntu's (3.8 on focal). duckdb 1.5.5 publishes no wheel
# for that interpreter, so pip reports nothing newer than 1.3.2.
# Python 3.12 matches the rest of the repo. Focal has no python3.12-venv
# package, so pip comes from get-pip.py. PySpark is pointed at python3.12.
FROM apache/spark:3.5.5

USER root

COPY requirements-runtime.txt /tmp/requirements-runtime.txt

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    install -d -m 0755 /usr/share/keyrings; \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
      | gpg --dearmor -o /usr/share/keyrings/deadsnakes.gpg; \
    . /etc/os-release; \
    echo "deb [signed-by=/usr/share/keyrings/deadsnakes.gpg] https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu ${VERSION_CODENAME} main" \
      > /etc/apt/sources.list.d/deadsnakes.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3.12; \
    curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.12; \
    python3.12 -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt; \
    rm -rf /var/lib/apt/lists/*

# Compose runs this image as ${AIRFLOW_UID}:0. The entrypoint adds that uid to
# /etc/passwd, and local spark-submit writes under the work dir and $HOME.
RUN chmod g=u /etc/passwd \
    && mkdir -p /opt/spark/work-dir \
    && chgrp -R 0 /opt/spark/work-dir \
    && chmod -R g+rwX /opt/spark/work-dir

WORKDIR /opt/project
ENV PYTHONPATH=/opt/project \
    HOME=/tmp \
    PYSPARK_PYTHON=/usr/bin/python3.12 \
    PYSPARK_DRIVER_PYTHON=/usr/bin/python3.12
